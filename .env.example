# Optional local model support. No hosted API key is required.
# Install and run Ollama separately only if you want local text generation.
LIFEOS_LLM_ENABLED=false
LIFEOS_OLLAMA_URL=http://127.0.0.1:11434
LIFEOS_OLLAMA_MODEL=qwen2.5:3b
LIFEOS_LLM_TIMEOUT=20

# Comma-separated frontend origins. Use explicit origins for hosted deployments.
# Example: LIFEOS_CORS_ORIGINS=https://sahanasri18.github.io,http://localhost:5173
LIFEOS_CORS_ORIGINS=*

# Required before deployment: generate a long random secret; never commit it.
# Example generation: python -c "import secrets; print(secrets.token_urlsafe(48))"
LIFEOS_AUTH_SECRET=replace-with-a-long-random-secret-before-deployment
LIFEOS_WORKSPACE_DB=backend/data/workspaces.sqlite3
